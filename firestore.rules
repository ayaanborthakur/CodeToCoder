rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

 
    match /users/{userId} {
  allow read, write: if isSignedIn() && isOwner(userId) || request.auth.token.admin == true;
  match /{allSubcollections=**} {
    allow read, write: if isSignedIn() && isOwner(userId) || request.auth.token.admin == true;
  }
}
		
    // --- Legacy / Root Support ---
    // Keeps support for any direct root-level collections if still in use
    
  

    // --- Username Registry ---
    // Specifically for unique username lookups
    

    match /leaderboard/{docId} {
      // Publicly readable
      allow read: if true;
      // Writing is handled via Cloud Functions in production,
      // but if writing from client, strictly limit to the user's entry
      allow write: if request.auth.token.admin == true;
    }

    // --- Classrooms ---
    // Teachers can create and update their own classroom.
    // Students can read a classroom (to see the join code screen) and join it
    // by adding themselves to studentIds — but cannot modify anything else.
    match /classrooms/{classId} {
      // Any signed-in user can read a classroom (needed to look up join codes)
      allow read: if isSignedIn();

      // Only the teacher who owns the classroom can create or fully update it
      allow create: if isSignedIn() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isSignedIn() && (
        // Teacher can update anything about their classroom
        resource.data.teacherId == request.auth.uid
        ||
        // Students can append their own uid to studentIds (join)
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentIds'])
          && request.resource.data.studentIds.hasAll(resource.data.studentIds)
          && request.resource.data.studentIds.size() == resource.data.studentIds.size() + 1
          && request.auth.uid in request.resource.data.studentIds
        )
        ||
        // Students can remove themselves from studentIds (leave)
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentIds'])
          && resource.data.studentIds.hasAll(request.resource.data.studentIds)
          && resource.data.studentIds.size() == request.resource.data.studentIds.size() + 1
          && request.auth.uid in resource.data.studentIds
          && !(request.auth.uid in request.resource.data.studentIds)
        )
      );

      // Only the owning teacher can delete a classroom
      allow delete: if isSignedIn() && resource.data.teacherId == request.auth.uid;

      // --- Assignments subcollection ---
      // Stored under classrooms/{classId}/assignments/{assignmentId}.
      // Only the classroom's teacher can create/update/delete assignments.
      // Members of the classroom (teacher + students) can read.
      match /assignments/{assignmentId} {
        function classroomData() {
          return get(/databases/$(database)/documents/classrooms/$(classId)).data;
        }
        function isClassTeacher() {
          return isSignedIn() && classroomData().teacherId == request.auth.uid;
        }
        function isClassMember() {
          return isSignedIn() && (
            classroomData().teacherId == request.auth.uid
            || request.auth.uid in classroomData().studentIds
          );
        }

        allow read: if isClassMember();
        allow create, update, delete: if isClassTeacher();
      }
    }

    // --- AI Feedback Cache ---
    // Written exclusively by Cloud Functions (admin SDK bypasses these rules).
    // Clients have no direct access — feedback is always proxied through the function.
    match /feedbackCache/{cacheKey} {
      allow read, write: if false;
    }

    // --- Global Deny Fallback ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}